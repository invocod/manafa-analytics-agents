# Copy this file to .env (same folder) and fill it in yourself. .env is git-ignored. Never commit it.

# --- Server ---
PORT=4600

# --- Google (BigQuery + Singular sheet) ---
# Sign-in happens with gcloud on this computer (see README, step 2). No key or password goes in this file.
GCP_PROJECT=databases-472111
BQ_LOCATION=me-central2
# Safety cap per query (bytes scanned). 3 GB is ~7x the largest dashboard query today.
BQ_MAX_BYTES=3000000000

# --- Jira (Issues and Bugs tab). Leave empty to keep the tab "not connected". ---
JIRA_BASE_URL=https://manafaco.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
ANTHROPIC_API_KEY=
